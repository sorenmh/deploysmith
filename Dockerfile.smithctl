# Build context is the repo root. `make docker-build` builds the image; lint and
# test run once for the whole repository in Dockerfile.smithd.

# --- build --------------------------------------------------------------------
FROM golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
ARG VERSION=dev
ARG COMMIT=unknown
COPY cmd/smithctl ./cmd/smithctl
COPY internal/smithctl ./internal/smithctl
COPY internal/shared ./internal/shared
RUN CGO_ENABLED=0 go build -trimpath -o /out/smithctl \
    -ldflags "-s -w -X github.com/sorenmh/deploysmith/internal/smithctl/cmd.Version=${VERSION} -X github.com/sorenmh/deploysmith/internal/smithctl/cmd.GitCommit=${COMMIT} -X github.com/sorenmh/deploysmith/internal/smithctl/cmd.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    ./cmd/smithctl

# --- runtime ------------------------------------------------------------------
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk add --no-cache ca-certificates \
    && addgroup -g 1000 smithctl && adduser -D -u 1000 -G smithctl smithctl
COPY --from=build /out/smithctl /usr/local/bin/smithctl
USER smithctl
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/smithctl"]
